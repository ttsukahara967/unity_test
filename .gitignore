# Keep .meta files of everything under Assets (they hold GUIDs)
!/[Aa]ssets/**/*.meta

# Generated IDE files (Unity regenerates them)
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Crash reports and build outputs
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app

# OS / local tooling
.DS_Store
.claude/settings.local.json
